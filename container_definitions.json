{
    "containerDefinitions": [
        {
            "name": "budget-tracking-container",
            "image": "418272791444.dkr.ecr.ap-south-1.amazonaws.com/budget-tracking-repo:latest",
            "cpu": 1024,
            "memory": 3072,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/budget-tracking",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "systemControls": []
        }
    ],
    "family": "budget-tracking-taskDef",
    "executionRoleArn": "arn:aws:iam::418272791444:role/ecs-task-execution-role",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "3072"
}